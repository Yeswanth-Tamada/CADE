# Copy this file to .env and adjust. Never commit real credentials.
# The LLM runs locally through Ollama; external security tools are optional (see below).

# development | test | production
CADE_APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
CADE_LOG_LEVEL=INFO

# SQLite database file (relative paths are relative to where you start the server)
CADE_DATABASE_URL=sqlite:///./cade.db

# API authentication. Every endpoint except /health needs 'Authorization: Bearer <key>'.
# Issue keys with: python -m app.security.keys create --analyst <id> --roles <roles>
# Disabling is for local development only; it is refused when CADE_APP_ENV=production.
CADE_AUTH_ENABLED=true

# LLM provider: "ollama" (real local model) or "mock" (offline, deterministic, NOT a real model)
CADE_LLM_PROVIDER=ollama
CADE_OLLAMA_BASE_URL=http://127.0.0.1:11434
CADE_OLLAMA_MODEL=llama3.2:3b
# Seconds to wait for one LLM response (local models on CPU can be slow)
CADE_LLM_REQUEST_TIMEOUT_SECONDS=120
# Total attempts when the model returns malformed output (1 = no retry)
CADE_LLM_MAX_ATTEMPTS=2

# MITRE ATT&CK STIX bundle. If the file is missing, ATT&CK mappings are
# reported as "unverified". Fetch it with: python scripts/fetch_attack_dataset.py
CADE_ATTACK_DATASET_PATH=app/data/attack/enterprise-attack.json
# Offer dataset technique names and well-known technique artifacts (app/data/attack_artifact_hints.json)
# found in the incident text to the model as hints (never as results)
CADE_ATTACK_PROMPT_HINTS=true
# Paper 968: intent extraction (activity -> ATT&CK technique -> tactic -> label), then the evidence
# profile, as two model calls. false = one combined call.
CADE_INTENT_TWO_STAGE=true

# Configurable intent taxonomy (implementation choice, see app/data/README.md)
CADE_INTENT_TAXONOMY_PATH=app/data/intent_taxonomy.json

# --- Security tools (evidence enrichment and playbook execution) -------------------------
# simulate (default): every tool call is answered by a deterministic simulator, labelled
#   SYNTHETIC, and never stored as observed evidence.
# live: calls go to the real tools configured below. An unconfigured or failing tool is
#   reported (error) or turned into a manual task -- it is never replaced by simulated data.
CADE_EXECUTION_MODE=simulate
CADE_TOOL_FAILURE_POLICY=manual_task
CADE_TOOL_TIMEOUT_SECONDS=20
CADE_TOOL_VERIFY_TLS=true
# Per-deployment probability that each evidence category can be obtained (routing's rho)
CADE_EVIDENCE_AVAILABILITY_PATH=app/data/evidence_availability.json

# VirusTotal (free tier works; client-side limit 4 requests/minute)
# CADE_VIRUSTOTAL_API_KEY=
# Wazuh server API (and the indexer, needed for alerts)
# CADE_WAZUH_API_URL=https://wazuh.example:55000
# CADE_WAZUH_USERNAME=
# CADE_WAZUH_PASSWORD=
# CADE_WAZUH_INDEXER_URL=https://wazuh.example:9200
# CADE_WAZUH_INDEXER_USERNAME=
# CADE_WAZUH_INDEXER_PASSWORD=
# Wazuh ships no isolation command; set the name of your own active-response script to enable isolation
# CADE_WAZUH_ISOLATION_COMMAND=
# Elasticsearch / Elastic Security (API key auth); Kibana is needed for host isolation
# CADE_ELASTIC_URL=https://elastic.example:9200
# CADE_ELASTIC_API_KEY=
# CADE_ELASTIC_INDEX_PATTERN=logs-*
# CADE_KIBANA_URL=https://kibana.example:5601
# osquery (queries the machine CADE runs on only)
# CADE_OSQUERY_BINARY=osqueryi
# YARA: only files inside the scan roots can be scanned (JSON list)
# CADE_YARA_BINARY=yara
# CADE_YARA_RULES_PATH=rules/index.yar
# CADE_YARA_SCAN_ROOTS=["C:/quarantine"]
# Sigma rules directory (needs Elastic and: pip install -r requirements-tools.txt)
# CADE_SIGMA_RULES_DIR=rules/sigma

# --- Controlled execution (safety gates) ------------------------------------------------------
# Extra gate for destructive actions against REAL tools in live mode. It never replaces the
# per-step analyst approval and the confirmed verification, which are always required.
CADE_ALLOW_DESTRUCTIVE_LIVE=false
# The analyst who approves a destructive step may not be the one who executes it
CADE_REQUIRE_SEPARATE_APPROVER=true
CADE_MAX_DESTRUCTIVE_TARGETS=1
CADE_MAX_TARGETS_PER_NODE=3
# Simulated runs only produce synthetic findings; allow them to train the library? (demos only)
CADE_LIBRARY_LEARN_FROM_SIMULATED=false

# --- Playbook synthesis (paper Section 5, Table 3) --------------------------------------------
# Three independently configured models: CADE_OLLAMA_MODEL (intent extraction), the generator and
# the operational-soundness judge. Use a judge from a different model family than the generator:
#   ollama pull qwen3:14b; ollama pull gemma3:12b
# (on small hardware e.g. llama3.2:3b as generator and qwen2.5:3b as judge)
CADE_GENERATOR_MODEL=qwen3:14b
CADE_JUDGE_MODEL=gemma3:12b
# llm | heuristic (OS_H only; the mock provider always uses it)
CADE_OS_JUDGE_MODE=llm
CADE_OS_JUDGE_SAMPLES=3
# m: candidates judged per generation
CADE_OS_JUDGE_TOP_K=5
# B: base pool size; one decoding temperature (paper: 0.8)
CADE_GENERATION_POOL_SIZE=20
CADE_GENERATION_TEMPERATURES=[0.8]
# Adaptive K: average-linkage clustering under the Jaccard distance, cut at tau
CADE_SEED_CLUSTER_THRESHOLD=0.3
# Optional guards on K (the paper leaves K unclamped)
# CADE_SEED_K_MIN=1
# CADE_SEED_K_MAX=8
# CADE evolution (paper: 30 candidates, <= 20 generations, 2 elites, 20-node cap)
CADE_POPULATION_SIZE=30
CADE_MAX_GENERATIONS=20
CADE_ELITE_COUNT=2
CADE_NODE_CAP=20
# Gap-directed additions ask the generator which action closes each gap
CADE_DIRECTED_MUTATION_LLM=true
CADE_MUTATION_RETRIES=3
# true: elites + offspring (paper); false: (mu + lambda) survival
CADE_GENERATIONAL_REPLACEMENT=true
# Stop at full coverage (IC = EA = 1); a value > 0 also requires that fitness
CADE_FITNESS_THRESHOLD=0.0
# Stop when the best fitness gained < epsilon over this many generations
CADE_PLATEAU_GENERATIONS=3
CADE_PLATEAU_EPSILON=0.01
# Where coverage steers the search (all true = full CADE)
CADE_COVERAGE_INIT=true
CADE_COVERAGE_VARIATION=true
CADE_COVERAGE_SELECTION=true
CADE_COVERAGE_TERMINATION=true
# Set for reproducible synthesis runs
# CADE_RANDOM_SEED=42

# --- Playbook library (paper Section 3) ---------------------------------------------------------
# sentence_transformers (paper; downloads all-MiniLM-L6-v2 on first use) | hashing (offline)
CADE_EMBEDDER=sentence_transformers
CADE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# faiss (paper) | numpy; falls back to numpy if faiss-cpu is not installed
CADE_VECTOR_INDEX=faiss
CADE_LIBRARY_SEED_ON_STARTUP=true
CADE_LIBRARY_DEPRIORITIZE_AFTER=5
CADE_LIBRARY_DEPRIORITIZE_BELOW=0.35

# --- Routing (paper Section 4: w = 0.7, k = 3, top N = 10) ------------------------------------
CADE_ROUTING_W=0.7
CADE_ROUTING_K=3
CADE_ROUTING_TOP_N=10
CADE_ROUTING_TAU=0.5
# Evidence requests per incident (paper: 1)
CADE_MAX_EVIDENCE_ROUNDS=1
# 1.0 = the paper's Eq. 2. Values > 1 sharpen the similarity distribution before the entropy is
# taken (implementation option; see README "Implementation choices").
CADE_ROUTING_SIMILARITY_SHARPNESS=1.0

# --- Learned routing (paper Sections 4.2-4.3, Table 3) -----------------------------------------
# linucb: the rule of Eq. 7 decides for the first CADE_BANDIT_BOOTSTRAP_INCIDENTS rewarded
#   incidents, then the LinUCB bandit does. rule: always the hand-designed rule (rewards still logged).
CADE_ROUTING_POLICY=linucb
CADE_BANDIT_ALPHA=1.0
CADE_BANDIT_RIDGE_LAMBDA=1.0
CADE_BANDIT_BOOTSTRAP_INCIDENTS=20
CADE_BANDIT_LIBRARY_SIZE_SCALE=50
# Simulated runs produce synthetic telemetry; allow them to train the router? (demos only)
CADE_BANDIT_LEARN_FROM_SIMULATED=false
# Reward (Eq. 9): r = retained * [lc * IC_exec + ll * (1 - latency / L_max)] - lq * c_q
CADE_REWARD_LAMBDA_COVERAGE=0.6
CADE_REWARD_LAMBDA_LATENCY=0.3
CADE_REWARD_LAMBDA_REQUEST=0.1
CADE_REWARD_REQUEST_COST=1.0
# L_max in seconds; unset = 90th percentile of the bootstrap incidents (fallback until then)
# CADE_REWARD_LATENCY_MAX_SECONDS=300
CADE_REWARD_LATENCY_FALLBACK_SECONDS=600
