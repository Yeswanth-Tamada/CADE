[Unit]
Description=CADE service
After=network.target docker.service
Wants=docker.service
[Service]
User=yeswanth
WorkingDirectory=/home/yeswanth/cade
ExecStart=/home/yeswanth/cade/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
